{
  "name": "workflow-app",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm --prefix ui run dev",
    "ui": "npm --prefix ui run dev",
    "server": "npm --prefix server start",
    "build": "npm --prefix ui run build",
    "preview": "npm --prefix ui run preview",
    "start": "NODE_ENV=production node server/src/index.js",
    "test": "node server/tests/api.test.mjs",
    "postinstall": "npm run install:all",
    "install:all": "cd server && npm install && cd ../ui && npm install",
    "check:orphans": "node scripts/check-orphaned-assets.js",
    "prune:orphans": "node scripts/check-orphaned-assets.js --prune",
    "dedupe:assets": "node scripts/dedupe-assets.js",
    "dedupe:dry": "node scripts/dedupe-assets.js --dry-run"
  },
  "dependencies": {
    "@gkucmierz/nano-ui": "^1.5.4",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "lucide-vue-next": "^1.0.0",
    "multer": "^1.4.5-lts.1",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "vite": "^6.0.7"
  },
  "overrides": {
    "qs": "^6.16.0"
  }
}
